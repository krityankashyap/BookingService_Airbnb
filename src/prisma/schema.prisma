generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Booking { 
  id               Int             @id @default(autoincrement())
  userId           Int   
  hotelId          Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  bookingAmount    Int
  status           BookingStatus   @default(PENDING)
  totalGuest       Int
  idempotencyKey   IdempotencyKey?  // the idempotencyKeyId property here is nothing but the id column of the idempotencyKey table
}

model IdempotencyKey {  // our agenda is final booking should be idempotent that means if u try multiple bookings it should work
  id            Int             @id @default(autoincrement())
  idemkey       String          @unique  // uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  bookindId     Int             @unique
  booking       Booking?        @relation(fields: [bookindId] , references: [id]) // the bookingId property here is nothing but the id column of the Booking table
  finalized     Boolean         @default(false)

}

enum BookingStatus {
   PENDING
   CONFIRMED
   CANCELLED
}
